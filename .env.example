# SS 13 — settings. In the SITE package this file is also shipped as .env (edit .env). Never commit .env.
# Existing environment variables win. Comments are on their own lines on purpose (Docker and shells read this file too).

# Your domain (Caddy uses it; the HTTPS certificate is automatic). Point its DNS A record at this server.
SS_DOMAIN=ss.example.ir
# Shown on the public «تماس» page. Change it any time; no rebuild needed.
SS_CONTACT_EMAIL=
PORT=8080
# json (default) | sqlite (node:sqlite, Node 22.5+) | postgres (NOT implemented)
# SS_DB=json
# Management roles need a second factor (Authenticator). 0 = demo only!
SS_REQUIRE_MFA=1
# Behind HTTPS (production).
SS_COOKIE_SECURE=1
# Behind Caddy / nginx.
TRUST_PROXY=1
SS_TELEGRAM=0
# Local demo door on the login page — never in production.
# SS_DEMO=1
