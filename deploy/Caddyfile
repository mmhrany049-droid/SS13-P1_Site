# SS 13 — ONE domain for both halves (کابین مطالعه /today و میز کار /workspace). HTTPS certificate is obtained automatically.
# The domain comes from SS_DOMAIN in .env (with docker compose it is passed for you):  SS_DOMAIN=ss.example.ir
# Without Docker:  export $(grep -v '^#' .env | xargs) && caddy run --config deploy/Caddyfile
{$SS_DOMAIN:localhost} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	request_body { max_size 2MB }
	reverse_proxy {$SS_UPSTREAM:127.0.0.1:8080} { header_up X-Forwarded-Proto {scheme} }
}
www.{$SS_DOMAIN:localhost} { redir https://{$SS_DOMAIN:localhost}{uri} permanent }
